{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalcrossroads.example/schemas/food-resilience-scenario-definition-v0.1.schema.json",
  "title": "Food Resilience Scenario Definition v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "effects"
  ],
  "properties": {
    "schema": {
      "const": "food-resilience-scenario-definition-v0.1"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "content_type": {
      "const": "scenario_assumption"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      },
      "minItems": 0
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "factor"
      ],
      "properties": {
        "type": {
          "enum": [
            "offer_quantity_factor",
            "route_capacity_factor",
            "capacity_quantity_factor"
          ]
        },
        "factor": {
          "type": "number",
          "minimum": 0
        },
        "offer_id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "product_id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "region": {
          "type": "string"
        },
        "route_id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "mode": {
          "type": "string"
        },
        "origin_region": {
          "type": "string"
        },
        "destination_region": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "organisation_id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "product_code": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
